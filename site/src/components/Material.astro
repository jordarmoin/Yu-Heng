---
import {random} from '../lib/content';
const {kind='tape', seed=1, class:className=''}=Astro.props;
const r=random(seed);const wobble=(v:number)=>Math.round((v+(r()-.5)*3)*10)/10;
const points=Array.from({length:15},(_,i)=>`${i*8},${wobble(i%2?2:0)}`).join(' ');
const bottom=Array.from({length:15},(_,i)=>`${112-i*8},${wobble(i%2?28:30)}`).join(' ');
const kinds:Record<string,string>={
 tape:`<polygon points="${points} 113,16 ${bottom} -1,14" fill="currentColor"/><path d="M 3 8 Q 50 10 108 7 M 5 22 Q 48 19 108 23" stroke="currentColor" opacity=".24" fill="none"/>`,
 scrap:`<polygon points="${points} 113,16 ${bottom} -1,14" fill="var(--well)"/>`,
 seal:`<path d="M 2 1 L ${wobble(31)} 2 L 30 ${wobble(31)} L 1 30 Z" fill="var(--cinnabar)" stroke="var(--cinnabar)"/><path d="M 5 5 L 27 ${wobble(5)} L ${wobble(27)} 27 L 5 27 Z" stroke="white"/>`,
 stamp:`<path d="M 2 1 L ${wobble(31)} 2 L 30 ${wobble(31)} L 1 30 Z M 5 5 L 27 ${wobble(5)} L ${wobble(27)} 27 L 5 27 Z" stroke="var(--cinnabar)"/>`,
 corner:`<path d="M ${wobble(2)} 30 L ${wobble(2)} ${wobble(2)} L 30 ${wobble(2)} Z" fill="var(--well-2)" stroke="var(--rule-2)"/><path d="M 3 28 Q 14 17 29 3" fill="none" stroke="var(--rule-2)"/>`,
 clip:`<path d="M 16 38 L 16 9 C 16 0 30 -1 30 9 L 30 ${wobble(43)} C 30 56 8 57 8 43 L 8 11 C 8 -5 38 -5 38 11 L 38 ${wobble(39)}"/>`,
 arrow:`<path d="M 7 ${wobble(6)} C 75 -6 130 27 119 66 C 112 89 75 99 51 92 M 51 92 L 66 81 M 51 92 L 69 100"/>`,
 underline:`<path d="M 3 10 Q 30 ${wobble(6)} 59 9 T 117 7 M 8 13 Q 52 10 106 12"/>`,
 play:`<path d="M 32 4 C 68 0 70 63 35 65 C -6 68 -8 7 32 4 Z M 26 20 L 46 34 L 25 47 Z"/>`,
 sun:`<path d="M 12 6 C 20 5 20 19 12 18 C 4 19 4 5 12 6 Z M 12 1 L 12 3 M 12 21 L 12 23 M 1 12 L 3 12 M 21 12 L 23 12 M 4 4 L 6 6 M 18 18 L 20 20 M 4 20 L 6 18 M 18 6 L 20 4"/>`,
 moon:`<path d="M 15 2 C 1 1 -2 21 12 22 C 18 22 23 18 22 13 C 14 18 8 8 15 2 Z"/>`,
 caret:`<path d="M 3 3 Q 8 7 12 11 L 21 3"/>`,
};
const view=['corner','seal','stamp'].includes(kind)?'0 0 32 32':kind==='clip'?'0 0 46 60':kind==='arrow'?'0 0 140 110':kind==='play'?'0 0 70 70':['sun','moon','caret'].includes(kind)?'0 0 24 24':kind==='underline'?'0 0 120 18':'0 0 114 32';
---
<svg class:list={['material',kind,className]} viewBox={view} preserveAspectRatio={kind==='scrap'?'none':undefined} aria-hidden="true" fill="none" stroke={['tape','corner','scrap'].includes(kind)?'none':'currentColor'} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={kinds[kind]||kinds.tape}/>
