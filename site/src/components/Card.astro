---
import fs from 'node:fs';
import {t,words,fileTree,publicRoot} from '../lib/content';
import FileNode from './FileNode.astro';
import Material from './Material.astro';
const {item,lang}=Astro.props;const w=words(lang);const files=fileTree(item);
const seal=`/brand/seal-year-${item.year}.svg`;const hasSeal=fs.existsSync(publicRoot+seal);
---
<section class="catalogue-card" aria-labelledby="work-title">
 <Material kind="clip" seed={item.seed}/>
 <h1 class="hand" id="work-title">{t(item.title,lang)}</h1>
 <p class="other-title" lang={lang==='zh'?'en':'zh'}>{t(item.title,lang==='zh'?'en':'zh')}</p>
 <dl>{[[w.year,item.year],[w.medium,t(item.medium,lang)],[w.tools,item.tools?.join(' · ')],[w.spec,t(item.spec,lang)]].map(([label,value])=><div><dt>{label}</dt><dd>{value||'—'}</dd></div>)}</dl>
 <p class="summary">{t(item.summary,lang)}</p>
 {files.length>0&&<details class="files"><summary><Material kind="caret" seed={item.seed}/>{w.files}</summary><ul class="file-tree">{files.map(node=><FileNode node={node} lang={lang}/>)}</ul></details>}
 {hasSeal&&<img class="year-seal" src={seal} width="100" height="100" alt="" aria-hidden="true"/>}
</section>
